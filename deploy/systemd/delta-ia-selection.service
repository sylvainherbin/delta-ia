[Unit]
Description=Delta — produit et publie la sélection hebdomadaire S1
ConditionPathExists=%h/projets/delta-ia/scripts/selection_auto.py

[Service]
Type=oneshot
WorkingDirectory=%h/projets/delta-ia
# Témoin d'incident (orchestrateur, code 126), EN PREMIER, avant tout git : un hook, un réglage git ou un .pth du .venv
# peut avoir été posé ; ni git ni le Python du .venv ne sont lancés tant que le superviseur ne l'a pas levé.
ExecStartPre=/usr/bin/python3 -I -S -c "import os, sys; t = 'rapports/auto/incident-git.json'; i = os.path.lexists(t); sys.stderr.write('INCIDENT_GIT : ' + t + ' non levé, rien n est lancé\\n' if i else ''); sys.exit(126 if i else 0)"
# SUITE 4, point 1 : parcours de scripts/ SANS git (un core.fsmonitor posé s'exécute au ls-files comme au status), en
# Python isolé : tout *.pyc, *.pyo, *.so ou *.pyd hors de __pycache__/ (écarté par PYTHONPYCACHEPREFIX) arrête ; un
# zoneinfo.pyc sans source, ignoré par git, y serait importé.
ExecStartPre=/usr/bin/python3 -I -S -c "import os, sys; x = ('.pyc', '.pyo', '.so', '.pyd'); b = sorted(os.path.join(d, f) for d, s, fs in os.walk('scripts', onerror=lambda e: (sys.stderr.write('ARBRE_CODE_SALE : scripts illisible (' + str(e) + '), rien n est lancé\\n'), os._exit(126))) if '__pycache__' not in d.split(os.sep) for f in fs if f.lower().endswith(x)); sys.stderr.write('ARBRE_CODE_SALE : binaires hors de __pycache__ sous scripts : ' + ' '.join(b[:5]) + ', rien n est lancé\\n' if b else ''); sys.exit(126 if b else 0)"
# SUITE 4, point 2 : avant le seul git de la garde, sans git, .git/config, .git/info/attributes, .git/info/exclude et
# .git/hooks/ comparés à la référence que l'orchestrateur écrit hors de l'arbre à la fin de chaque chaîne propre
# (${XDG_STATE_HOME:-~/.local/state}/delta-ia/empreinte-git.json). Référence absente ou différente : 126 et une ligne au
# journal des passages. Après une installation, 126 jusqu'à la première chaîne propre.
ExecStartPre=/usr/bin/python3 -I -S -c "import hashlib, json, os, sys, time; sys.excepthook = lambda t, v, b: (sys.stderr.write('EMPREINTE_GIT : contrôle en échec (' + repr(v) + '), git n est pas lancé\\n'), os._exit(126)); h = lambda p: 'lien:' + os.readlink(p) if os.path.islink(p) else hashlib.sha256(open(p, 'rb').read()).hexdigest() if os.path.isfile(p) else None; e = {'racine': os.path.realpath('.'), 'config': h('.git/config'), 'info/attributes': h('.git/info/attributes'), 'info/exclude': h('.git/info/exclude'), 'hooks': {n: h('.git/hooks/' + n) for n in sorted(os.listdir('.git/hooks'))} if os.path.isdir('.git/hooks') else None} if os.path.isdir('.git') and not os.path.islink('.git') else None; f = os.path.join(os.environ.get('XDG_STATE_HOME') or os.path.join(os.path.expanduser('~'), '.local', 'state'), 'delta-ia', 'empreinte-git.json'); r = json.load(open(f, encoding='utf-8')) if os.path.isfile(f) else None; ok = e is not None and r == e; m = '' if ok else 'EMPREINTE_GIT : ' + ('.git n est pas un dossier' if e is None else 'référence absente (' + f + ')' if r is None else 'différent de la référence : ' + ', '.join(k for k in sorted(e) if not isinstance(r, dict) or r.get(k) != e[k])) + ', git n est pas lancé'; sys.stderr.write(m + '\\n' if m else ''); ok or (os.makedirs('rapports', exist_ok=True), open('rapports/passages.log', 'a', encoding='utf-8').write('{:04d}-{:02d}-{:02d}_{:02d}{:02d}'.format(*time.localtime()[:5]) + ' | orchestrateur | ' + sys.argv[1] + ' | 0 éléments (0 fort) | aucun | 126 | ' + m + '\\n')); sys.exit(0 if ok else 126)" selection-git
# Python isolé : aucun module du dépôt n’est importé avant le contrôle de son arbre (modifié, indexé ou non suivi). Le
# fsmonitor et les hooks sont neutralisés pour ce git.
ExecStartPre=/usr/bin/python3 -I -S -c "import subprocess, sys; r = subprocess.run(['git', '-c', 'core.fsmonitor=false', '-c', 'core.hooksPath=/dev/null', 'status', '--porcelain=v1', '--untracked-files=all', '--', 'scripts'], capture_output=True); sale = r.returncode != 0 or bool(r.stdout); sys.stderr.write('ARBRE_CODE_SALE : contrôle avant imports, scripts modifié ou non suivi\\n' if sale else ''); sys.exit(126 if sale else 0)"
ExecStart=%h/projets/delta-ia/.venv/bin/python -B scripts/selection_auto.py
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=TZ=Europe/Paris LANG=C.UTF-8 LC_ALL=C.UTF-8 GIT_TERMINAL_PROMPT=0
# B2 : les .pyc se lisent et s'écrivent hors de l'arbre ; un __pycache__/ piégé dans scripts/ (ignoré par git) n'est pas chargé.
Environment=PYTHONPYCACHEPREFIX=%t/delta-ia-pycache
# Attend le verrou partagé si la chaîne de 04:00 travaille encore (au plus 4 h).
TimeoutStartSec=4h15min
KillMode=control-group
Nice=10
