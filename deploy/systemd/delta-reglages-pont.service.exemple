# Copie de référence : ~/.config/systemd/user/delta-reglages-pont.service (installation après la fusion, voir deploy/systemd/reglages-pont.md).
[Unit]
Description=Delta — constats internes des fiches de modèles (branche dédiée, boîte du chef dev, sans push)
ConditionPathExists=%h/projets/delta-ia/scripts/reglages-pont.sh

[Service]
Type=oneshot
WorkingDirectory=%h/projets/delta-ia
# Garde des unités delta-ia. Témoin d'incident EN PREMIER (ni git ni Python du dépôt tant qu'il existe), puis
# (SUITE 4, point 1) parcours de scripts/ SANS git, un core.fsmonitor ou un hook posé s'exécutant au premier git :
# tout *.pyc, *.pyo, *.so ou *.pyd hors de __pycache__/ arrête (un .pyc sans source y serait importé). Aucun git ici.
ExecStartPre=/usr/bin/python3 -I -S -c "import os, sys; t = 'rapports/auto/incident-git.json'; i = os.path.lexists(t); sys.stderr.write('INCIDENT_GIT : ' + t + ' non levé, rien n est lancé\\n' if i else ''); sys.exit(126 if i else 0)"
# SUITE 5, point 3 : tout lien symbolique sous scripts/ (scripts/ compris, __pycache__/ compris) arrête aussi.
ExecStartPre=/usr/bin/python3 -I -S -c "import os, sys; x = ('.pyc', '.pyo', '.so', '.pyd'); w = list(os.walk('scripts', onerror=lambda e: (sys.stderr.write('ARBRE_CODE_SALE : scripts illisible (' + str(e) + '), rien n est lancé\\n'), os._exit(126)))); l = (['scripts'] if os.path.islink('scripts') else []) + sorted(os.path.join(d, n) for d, s, fs in w for n in s + fs if os.path.islink(os.path.join(d, n))); b = sorted(os.path.join(d, f) for d, s, fs in w if '__pycache__' not in d.split(os.sep) for f in fs if f.lower().endswith(x)); sys.stderr.write('ARBRE_CODE_SALE : liens symboliques sous scripts : ' + ' '.join(l[:5]) + ', rien n est lancé\\n' if l else ''); sys.stderr.write('ARBRE_CODE_SALE : binaires hors de __pycache__ sous scripts : ' + ' '.join(b[:5]) + ', rien n est lancé\\n' if b else ''); sys.exit(126 if l or b else 0)"
ExecStart=%h/projets/delta-ia/scripts/reglages-pont.sh
# Les .pyc se lisent et s'écrivent hors de l'arbre : un __pycache__/ piégé dans scripts/ n'est pas chargé.
Environment=PYTHONPYCACHEPREFIX=%t/delta-ia-pycache
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=TZ=Europe/Paris LANG=C.UTF-8 LC_ALL=C.UTF-8 GIT_TERMINAL_PROMPT=0
# Un lancement dans la fenêtre 03:30–08:00 attend 08:05 (au plus 4 h 35) puis travaille.
TimeoutStartSec=5h
KillMode=control-group
Nice=10
# Code 3 : une source du bilan en échec (dite au chef) ; l'unité l'affiche « failed » jusqu'au passage suivant.
