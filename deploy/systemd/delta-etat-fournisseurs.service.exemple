# Installé le 13/10/2026 (mission m-f8034da39359, FULL_AUTO) dans ~/.config/systemd/user/delta-etat-fournisseurs.service.
# Copie de référence ; le relevé n'écrit que ~/.local/state/delta/etat-fournisseurs.json (jamais docs/data, state/ ni raw/).
[Unit]
Description=Delta — état des fournisseurs en continu (pages d'état OpenAI et Anthropic)
Documentation=file:%h/projets/delta-ia/scripts/etat_fournisseurs.py
# Tant que le script n'est pas sur main (avant la fusion de la mission), le relevé est sauté sans échec.
ConditionPathExists=%h/projets/delta-ia/scripts/etat_fournisseurs.py

[Service]
Type=oneshot
WorkingDirectory=%h/projets/delta-ia
# SUITE 3, B2b : garde des unités delta-ia. Témoin d'incident EN PREMIER (ni git ni Python du dépôt tant qu'il existe),
# puis aucun fichier IGNORÉ sous scripts/ hors __pycache__/ (un .pyc sans source y serait importé).
ExecStartPre=/usr/bin/python3 -I -S -c "import os, sys; t = 'rapports/auto/incident-git.json'; i = os.path.lexists(t); sys.stderr.write('INCIDENT_GIT : ' + t + ' non levé, rien n est lancé\\n' if i else ''); sys.exit(126 if i else 0)"
ExecStartPre=/usr/bin/python3 -I -S -c "import subprocess, sys; o = subprocess.run(['git', 'ls-files', '-o', '-i', '--exclude-standard', '--', 'scripts'], capture_output=True); ignores = [p for p in o.stdout.decode(errors='replace').splitlines() if '/__pycache__/' not in p]; sale = o.returncode != 0 or bool(ignores); sys.stderr.write('ARBRE_CODE_SALE : fichiers ignorés sous scripts : ' + ' '.join(ignores[:5]) + '\\n' if sale else ''); sys.exit(126 if sale else 0)"
ExecStart=%h/projets/delta-ia/.venv/bin/python -B scripts/etat_fournisseurs.py
# Les .pyc se lisent et s'écrivent hors de l'arbre : un __pycache__/ piégé dans scripts/ n'est pas chargé.
Environment=PYTHONPYCACHEPREFIX=%t/delta-ia-pycache
# operer (message au rôle delta) vit dans ~/.local/bin, absent du PATH par défaut de systemd --user.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Code 1 : une page d'état en échec (le fichier est écrit quand même) ; l'unité l'affiche « failed » jusqu'au relevé suivant.
Nice=10
TimeoutStartSec=3min
