# EXEMPLE (m-944fab565b10) — relais local du bouton « Envoyer à Delta » de l'onglet Référence. À copier dans
# ~/.config/systemd/user/delta-ia-relais.service, puis `systemctl --user daemon-reload` et
# `systemctl --user enable --now delta-ia-relais.service`. Écoute sur 127.0.0.1:47613 seulement.
#
# Le relais lit la base dans l'arbre principal (docs/data/kb, sur main) et remet l'idée à la porte des idées du bureau
# (~/.local/share/delta-system-experience/palier-3/idee.py, qui lance juger détaché).
[Unit]
Description=Delta — relais local « Envoyer à Delta » (onglet Référence → juger)
Documentation=file:%h/projets/delta-ia/scripts/relais_reference.py
# SUITE 4, point 4 : une garde qui refuse (126) ne relance pas l'unité toutes les 5 s sans fin (voir Restart=).
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/projets/delta-ia
# Garde des unités delta-ia. Témoin d'incident EN PREMIER (ni git ni Python du dépôt tant qu'il existe), puis
# (SUITE 4, point 1) parcours de scripts/ SANS git, un core.fsmonitor ou un hook posé s'exécutant au premier git :
# tout *.pyc, *.pyo, *.so ou *.pyd hors de __pycache__/ arrête (un .pyc sans source y serait importé). Aucun git ici.
ExecStartPre=/usr/bin/python3 -I -S -c "import os, sys; t = 'rapports/auto/incident-git.json'; i = os.path.lexists(t); sys.stderr.write('INCIDENT_GIT : ' + t + ' non levé, rien n est lancé\\n' if i else ''); sys.exit(126 if i else 0)"
ExecStartPre=/usr/bin/python3 -I -S -c "import os, sys; x = ('.pyc', '.pyo', '.so', '.pyd'); b = sorted(os.path.join(d, f) for d, s, fs in os.walk('scripts', onerror=lambda e: (sys.stderr.write('ARBRE_CODE_SALE : scripts illisible (' + str(e) + '), rien n est lancé\\n'), os._exit(126))) if '__pycache__' not in d.split(os.sep) for f in fs if f.lower().endswith(x)); sys.stderr.write('ARBRE_CODE_SALE : binaires hors de __pycache__ sous scripts : ' + ' '.join(b[:5]) + ', rien n est lancé\\n' if b else ''); sys.exit(126 if b else 0)"
ExecStart=/usr/bin/python3 %h/projets/delta-ia/scripts/relais_reference.py
# Les .pyc se lisent et s'écrivent hors de l'arbre : un __pycache__/ piégé dans scripts/ n'est pas chargé.
Environment=PYTHONPYCACHEPREFIX=%t/delta-ia-pycache
Restart=on-failure
RestartSec=5
# SUITE 4, point 4 : pas de redémarrage sur le 126 d'une garde. RestartPreventExitStatus ne vaut que pour le processus
# principal (systemd.service(5) : sans effet sur ExecStartPre=) ; les gardes étant des ExecStartPre, c'est la limite de
# démarrages de [Unit] (StartLimitBurst) qui arrête la boucle : 3 démarrages en 60 s, puis l'unité reste en échec.
RestartPreventExitStatus=126

[Install]
WantedBy=default.target
